diff --git a/src/flux_hs.hpp b/src/flux_hs.hpp
new file mode 100644
--- /dev/null
+++ b/src/flux_hs.hpp
@@ -0,0 +1,101 @@
+#ifndef PICTOR_FLUX_HS_HPP
+#define PICTOR_FLUX_HS_HPP
+
+#include "ggml.h"
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <vector>
+
+// Pictor's port of ultra-fast-image-gen's 2x2 hidden-state residual compression.
+// Each image has its own rectangular grid. Odd edges repeat their final row/column
+// when pooling, so a partial cell averages only its valid pixels. Text stays intact.
+namespace FluxHS {
+struct Grid { int width; int height; };
+struct Plan {
+    int text_tokens = 0;
+    std::array<std::vector<int32_t>, 4> pool;
+    std::vector<int32_t> restore;
+    std::vector<int32_t> positions;
+};
+inline bool active(bool enabled, int step, int steps) {
+    return enabled && step > 0 && step < steps;
+}
+inline Plan make_plan(int text_tokens, const std::vector<Grid>& grids) {
+    GGML_ASSERT(text_tokens >= 0);
+    Plan plan;
+    plan.text_tokens = text_tokens;
+    for (int i = 0; i < text_tokens; ++i) plan.positions.push_back(i);
+    int image_offset = 0, low_offset = 0;
+    for (const auto& grid : grids) {
+        GGML_ASSERT(grid.width > 0 && grid.height > 0);
+        const int low_width = (grid.width + 1) / 2;
+        const int low_height = (grid.height + 1) / 2;
+        for (int y = 0; y < grid.height; y += 2) {
+            for (int x = 0; x < grid.width; x += 2) {
+                for (int dy = 0; dy < 2; ++dy)
+                    for (int dx = 0; dx < 2; ++dx)
+                        plan.pool[dy * 2 + dx].push_back(image_offset +
+                            std::min(y + dy, grid.height - 1) * grid.width + std::min(x + dx, grid.width - 1));
+                plan.positions.push_back(text_tokens + plan.pool[3].back());
+            }
+        }
+        for (int y = 0; y < grid.height; ++y)
+            for (int x = 0; x < grid.width; ++x)
+                plan.restore.push_back(low_offset + (y / 2) * low_width + x / 2);
+        image_offset += grid.width * grid.height;
+        low_offset += low_width * low_height;
+    }
+    return plan;
+}
+
+struct Graph {
+    int text_tokens = 0;
+    std::array<ggml_tensor*, 4> pool{};
+    ggml_tensor* restore = nullptr;
+    ggml_tensor* pe = nullptr;
+
+    ggml_tensor* image_slice(ggml_context* ctx, ggml_tensor* x) const {
+        GGML_ASSERT(x->ne[2] == 1 && x->ne[3] == 1);
+        return ggml_view_2d(ctx, x, x->ne[0], x->ne[1] - text_tokens, x->nb[1], text_tokens * x->nb[1]);
+    }
+    ggml_tensor* join_text(ggml_context* ctx, ggml_tensor* source, ggml_tensor* image) const {
+        if (text_tokens == 0) return image;
+        auto text = ggml_view_2d(ctx, source, source->ne[0], text_tokens, source->nb[1], 0);
+        return ggml_concat(ctx, text, image, 1);
+    }
+    ggml_tensor* reduce(ggml_context* ctx, ggml_tensor* x) const {
+        auto image = image_slice(ctx, x);
+        auto top = ggml_add(ctx, ggml_get_rows(ctx, image, pool[0]), ggml_get_rows(ctx, image, pool[1]));
+        auto bottom = ggml_add(ctx, ggml_get_rows(ctx, image, pool[2]), ggml_get_rows(ctx, image, pool[3]));
+        return join_text(ctx, x, ggml_scale(ctx, ggml_add(ctx, top, bottom), 0.25f));
+    }
+    ggml_tensor* expand_residual(ggml_context* ctx, ggml_tensor* original,
+                                  ggml_tensor* reduced, ggml_tensor* updated) const {
+        auto delta = ggml_sub(ctx, image_slice(ctx, updated), image_slice(ctx, reduced));
+        auto restored = ggml_add(ctx, image_slice(ctx, original), ggml_get_rows(ctx, delta, restore));
+        return join_text(ctx, updated, restored);
+    }
+};
+
+// Upload callbacks must retain the Plan's storage until graph execution finishes.
+template<class Upload>
+Graph make_graph(ggml_context* ctx, const Plan& plan, ggml_tensor* pe, Upload upload) {
+    Graph graph;
+    graph.text_tokens = plan.text_tokens;
+    auto indices = [&](const std::vector<int32_t>& values) {
+        auto tensor = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, values.size());
+        upload(tensor, values.data());
+        return tensor;
+    };
+    for (int i = 0; i < 4; ++i) graph.pool[i] = indices(plan.pool[i]);
+    graph.restore = indices(plan.restore);
+    GGML_ASSERT(pe->ne[3] == static_cast<int64_t>(plan.restore.size()) + plan.text_tokens);
+    auto positions = indices(plan.positions);
+    auto flat_pe = ggml_reshape_2d(ctx, pe, pe->ne[0] * pe->ne[1] * pe->ne[2], pe->ne[3]);
+    graph.pe = ggml_reshape_4d(ctx, ggml_get_rows(ctx, flat_pe, positions),
+                               pe->ne[0], pe->ne[1], pe->ne[2], plan.positions.size());
+    return graph;
+}
+} // namespace FluxHS
+#endif
